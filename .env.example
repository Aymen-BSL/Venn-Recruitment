# Server-only Supabase configuration. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_CV_BUCKET=candidate-cvs

# Server-only ClickUp configuration.
CLICKUP_API_TOKEN=replace-with-your-clickup-api-token
CLICKUP_CONTACT_LIST_ID=123456789
CLICKUP_CANDIDATE_LIST_ID=123456789
CLICKUP_HIRING_LIST_ID=123456789
CLICKUP_RETRY_SECRET=replace-with-at-least-32-random-characters
